# Скопируй этот файл в secrets.env и впиши свои данные.
# secrets.env никому не пересылай и не выкладывай.

# Адрес ящика (Gmail или Яндекс — как указано в config.yaml → mail.provider)
EMAIL_USER=you@gmail.com

# Пароль ПРИЛОЖЕНИЯ, не основной пароль от почты.
#  Gmail: включить двухэтапную проверку → myaccount.google.com/apppasswords → создать пароль (16 символов)
#  Яндекс: Почта → Все настройки → Почтовые программы → включить IMAP и «Пароли приложений»,
#          затем id.yandex.ru → Безопасность → Пароли приложений → Почта
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
